{
  "manifest_version": 3,
  "name": "Quickshell Focus Blocker",
  "version": "1.0.0",
  "description": "Enforces Quickshell focus sessions in Helium.",
  "key": "",
  "permissions": ["alarms", "declarativeNetRequest", "nativeMessaging", "storage", "tabs", "webNavigation", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{
    "resources": ["blocked.html", "blocked.js", "blocked.css"],
    "matches": ["<all_urls>"]
  }]
}
