{
  "$schema": "https://opencode.ai/config.json",
  "skills": {},
  "provider": {
  },
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "websearch_exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    }
  }
}
