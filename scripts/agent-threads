#!/usr/bin/env python3
"""Print coding-agent threads from Claude Code, OpenCode and omp as JSON.

One list, newest first: {tool, id, title, folder, missing, updated, argv,
terminal}. `updated` is in epoch milliseconds; `argv` resumes the thread when
run in `folder`; `missing` marks a folder that no longer exists; `terminal` is
the address of the live Herdr terminal running the thread, or null. The Herdr
app's threads mod (herdr-app/mods/threads) shows this list and reads the
terminal's agent status live.

A terminal is matched to its thread by the agent's foreground pid: Claude Code
names its session in ~/.claude/sessions/<pid>.json, and a resumed omp or
OpenCode carries it on its command line. Anything else takes the newest
unclaimed thread of its tool in its folder. Only this machine's terminals are
matched; the mod runs this script on each machine to show its threads.

Claude Code sessions can be tens of MiB, so their titles are cached by file
size and mtime in $XDG_CACHE_HOME/agent-threads.json.
"""
import json
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

home = Path.home()
cache_path = Path(os.environ.get("XDG_CACHE_HOME", home / ".cache")) / "agent-threads.json"
claude_root = home / ".claude/projects"
claude_sessions = home / ".claude/sessions"
omp_root = home / ".omp/agent/sessions"


def resume(command, *args):
    """argv running command through an interactive zsh, so aliases (claude's
    --mcp-config) apply: Herdr runs a tab's argv as "$@", which skips them."""
    return ["zsh", "-ic", " ".join([command, *map(shlex.quote, args)])]


def text_of(content):
    """The first plain text of a message's content, or None."""
    if isinstance(content, str):
        return content
    for part in content or []:
        if isinstance(part, dict) and part.get("type") == "text" and part.get("text"):
            return part["text"]
    return None


def first_line(text):
    for line in (text or "").splitlines():
        line = line.strip()
        # Skip Claude's injected command and caveat blocks.
        if line and not line.startswith("<"):
            return line[:200]
    return None


def claude_thread(path):
    title = ai_title = prompt = folder = None
    with path.open("rb") as lines:
        for raw in lines:
            if b'"custom-title"' in raw or b'"ai-title"' in raw:
                entry = json.loads(raw)
                if entry.get("type") == "custom-title":
                    title = entry.get("customTitle") or title
                elif entry.get("type") == "ai-title":
                    ai_title = entry.get("aiTitle") or ai_title
            elif folder is None and b'"cwd"' in raw:
                folder = json.loads(raw).get("cwd")
            if prompt is None and b'"type":"user"' in raw:
                entry = json.loads(raw)
                if not entry.get("isSidechain"):
                    prompt = first_line(text_of(entry.get("message", {}).get("content")))
    if not (title or ai_title or prompt) or not folder:
        return None
    return {"title": title or ai_title or prompt, "folder": folder}


def claude_threads(cache):
    fresh = {}
    for path in claude_root.glob("*/*.jsonl"):
        stat = path.stat()
        key = str(path)
        stamp = [stat.st_size, stat.st_mtime_ns]
        cached = cache.get(key)
        if cached and cached["stamp"] == stamp:
            info = cached["info"]
        else:
            try:
                info = claude_thread(path)
            except (OSError, ValueError):
                info = None
        fresh[key] = {"stamp": stamp, "info": info}
        if info:
            yield {
                "tool": "claude",
                "id": path.stem,
                "title": info["title"],
                "folder": info["folder"],
                "updated": stat.st_mtime_ns // 1_000_000,
                "argv": resume("claude --resume", path.stem),
            }
    cache.clear()
    cache.update(fresh)


def omp_threads():
    for path in omp_root.glob("*/*.jsonl"):
        title = session = None
        try:
            with path.open() as lines:
                for number, line in enumerate(lines):
                    entry = json.loads(line)
                    kind = entry.get("type")
                    if kind == "title":
                        title = entry.get("title")
                    elif kind == "session":
                        session = entry
                    elif kind == "message" and not title and entry.get("message", {}).get("role") == "user":
                        title = first_line(text_of(entry["message"].get("content")))
                    if (title and session) or number > 50:
                        break
        except (OSError, ValueError):
            continue
        if not session or not session.get("cwd"):
            continue
        yield {
            "tool": "omp",
            "id": session.get("id") or path.stem,
            "title": title or "Untitled",
            "folder": session["cwd"],
            "updated": path.stat().st_mtime_ns // 1_000_000,
            "argv": resume("omp --resume", str(path)),
        }


def opencode_threads():
    if not shutil.which("opencode"):
        return
    try:
        result = subprocess.run(["opencode", "session", "list", "--format", "json"], capture_output=True, text=True, timeout=20)
        sessions = json.loads(result.stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return
    for session in sessions if isinstance(sessions, list) else []:
        folder = session.get("directory") or session.get("cwd")
        if not session.get("id") or not folder:
            continue
        updated = session.get("updated") or (session.get("time") or {}).get("updated") or 0
        yield {
            "tool": "opencode",
            "id": session["id"],
            "title": session.get("title") or "Untitled",
            "folder": folder,
            "updated": int(updated),
            "argv": resume("opencode -s", session["id"]),
        }


# OSC 7501 app names, as Herdr reports them, by thread tool.
agent_tools = {"claude-code": "claude", "claude": "claude", "opencode": "opencode", "omp": "omp", "pi": "omp"}


def hc_json(*args):
    try:
        result = subprocess.run(["hc", *args, "--json"], capture_output=True, text=True, timeout=5)
        return json.loads(result.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def session_of(tool, pid, argv):
    """The thread id a running agent has open, if it says."""
    if tool == "claude":
        try:
            return json.loads((claude_sessions / f"{pid}.json").read_text()).get("sessionId")
        except (OSError, ValueError):
            return None
    for flag in ("--resume", "-s", "--session"):
        if flag in argv[:-1]:
            value = argv[argv.index(flag) + 1]
            return omp_session(Path(value)) if tool == "omp" else value
    if tool == "omp":
        # omp keeps its session file open (Linux only: /proc).
        try:
            for fd in Path(f"/proc/{pid}/fd").iterdir():
                target = Path(os.readlink(fd))
                if target.suffix == ".jsonl" and omp_root in target.parents:
                    return omp_session(target)
        except OSError:
            pass
    return None


def omp_session(path):
    """An omp session file is named <timestamp>_<session id>.jsonl."""
    return path.stem.rpartition("_")[2]


def link_terminals(threads):
    """Set each thread's `terminal` to the live Herdr agent terminal running it."""
    for thread in threads:
        thread["terminal"] = None
    if not shutil.which("hc"):
        return
    listing = hc_json("ls") or {}
    by_key = {(thread["tool"], thread["id"]): thread for thread in threads}
    unmatched = []
    for entry in listing.get("terminals", []):
        tool = agent_tools.get(entry.get("agent") or "")
        # Another machine's terminals (machine/t1) run that machine's threads.
        if entry.get("state") != "live" or not entry.get("status") or not tool or "/" in entry["address"]:
            continue
        foreground = (hc_json("get", entry["address"]) or {}).get("foreground") or {}
        session = session_of(tool, foreground.get("pid"), foreground.get("argv") or [])
        thread = by_key.get((tool, session))
        if thread and not thread["terminal"]:
            thread["terminal"] = entry["address"]
        else:
            unmatched.append((tool, foreground.get("cwd") or entry.get("cwd"), entry["address"]))
    for tool, folder, address in unmatched:
        # threads is newest first, so this is the most recently written one.
        thread = next((t for t in threads if t["tool"] == tool and t["folder"] == folder and not t["terminal"]), None)
        if thread:
            thread["terminal"] = address


try:
    cache = json.loads(cache_path.read_text())
except (OSError, ValueError):
    cache = {}
threads = [*claude_threads(cache), *omp_threads(), *opencode_threads()]
try:
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    cache_path.write_text(json.dumps(cache))
except OSError:
    pass
for thread in threads:
    thread["missing"] = not os.path.isdir(thread["folder"])
threads.sort(key=lambda thread: thread["updated"], reverse=True)
link_terminals(threads)
json.dump(threads, sys.stdout, ensure_ascii=False)
