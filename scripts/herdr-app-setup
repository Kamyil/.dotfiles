#!/usr/bin/env python3
"""Apply the repository's Herdr app setup to ~/.config/herdr-app.

The app rewrites its home folder in place, so instead of symlinking its files
this merges the tracked pieces into them. Safe to re-run; it only writes files
whose content changes. Start Herdr once first so its defaults exist.

- keys.json: herdr-app/keys.json removes ("unset") and binds ("set") keys on
  top of the app's defaults.
- layouts/main-nav.json, layouts/terminals-nav.json: Herdr's shipped main and
  terminals layouts plus an empty floating block holding the nav mod, which
  owns Ctrl+h/j/k/l. Regenerated from the shipped files, so re-running picks
  up Herdr's layout updates.
- layouts/threads.json: terminals-nav with a full-height left sidebar:
  Herdr's spaces list, the threads mod (Claude Code, OpenCode and omp threads,
  scripts/agent-threads) and the usage mod (Claude Code and Codex plan usage,
  scripts/agent-usage), top to bottom. The tab bar sits over the panes only
  and drops its space chip and macOS window-button inset; its tabs fill the
  bar Safari style, splitting its width evenly and shrinking as more open
  (mods/terminals-bar-square-threads). Its spaces list tints each machine's
  group (mods/spaces-square-threads): Mac gray, thinkpad light blue, malinka red,
  and puts CPU, GPU (malinka: SoC temperature), RAM and disk bars in each
  machine header (herdr-app/machine-stats.js). Each space's row ends with an
  icon per coding agent running in it (herdr-app/space-agents.js), and a
  space whose project has a favicon or app icon shows it in place of its
  letter square (herdr-app/space-favicons.js).
- layouts/quest.json: the threads layout dressed as a game HUD for Godot work
  (dark stone, gold): the sidebar's threads and usage mods in their hud skin
  (Quest log, Mana), and around the panes the hud mod's roles: a hotbar of
  tabs with Play/Stop for the Godot project in focus (F5/F8), the game's run
  log (hidden until Play, Ctrl+Shift+G) and a strip with commit XP, streak and
  session timer (herdr-app/mods/hud).
- mods/<name>-square: tighter-cornered copies of the shipped mods the nav
  layouts show (every .rounded*() call capped at corner_radius, 5px, and
  .rounded_full() made that radius), which those layouts use along with pane
  radius corner_radius. The threads sidebar's islands round at island_radius,
  8px, to sit with the window's corners. Herdr's own popup and dialog frames
  keep their own.
- The nav layouts park macOS's window buttons off the window
  (traffic_lights at -200, -200): Herdr can't turn them off, but it doesn't
  clamp where they go. The square tab bar copies drop the 72px inset left for
  them. Close and minimise with keys (Cmd+Q, Cmd+M, Alt+Space q).
- settings.json and the nav layouts use themes/dotfiles.json in dark mode,
  which scripts/herdr-theme writes from the current dotfiles palette.
- mods/nav, mods/threads, mods/usage and mods/hud come from nix/symlinks.nix (herdr-app/mods/*);
  this only checks them.
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

repo = Path(__file__).resolve().parent.parent
app_home = Path(os.environ.get("HERDR_APP_HOME", Path.home() / ".config/herdr-app"))
state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "dotfiles-theme"
nav_layouts = {"main-nav": "main", "terminals-nav": "terminals", "threads": "terminals", "quest": "terminals"}
linked_mods = ["nav", "threads", "usage", "hud"]


def threads_sidebar(gap, mods, skin=None):
    """The sidebar column, squared, its islands rounded at island_radius."""
    props = {"props": {"skin": skin}} if skin else {}
    sidebar = squared({
        "id": "threads",
        "type": "column",
        "gap": gap,
        "size": {"px": 300},
        "min": 220,
        "max": 520,
        "children": [
            {"id": "spaces", "type": "block", "size": {"px": 200}, "min": 90, "border": {"width": 1, "color": "border"}, "content": {"mod": "spaces"}},
            {"id": "thread-list", "type": "block", "content": {"mod": "threads", **props}},
            {"id": "usage", "type": "block", "size": {"px": 232}, "min": 120, "content": {"mod": "usage", **props}},
        ],
    }, mods)
    for island in sidebar["children"]:
        island["radius"] = island_radius
    return sidebar


# The terminals look marks the focused pane with a border barely lighter than
# the rest; the theme accent stands out without shouting. The look's own accent
# (a bright blue) is dropped so the dotfiles theme's, from the current palette
# (scripts/herdr-theme), shows through.
pane_focus = {"width": 1, "color": "accent"}
square_suffix = "-square"
# Corners in the nav layouts: pane frames and every rounded thing the copied
# mods draw (tabs, rows, buttons) use at most this many px. Small enough to
# stay nearly square, enough to sit with macOS Sequoia's window corners.
corner_radius = 5
# The sidebar's islands sit in the window's left corners, 6px (the layout's
# padding) inside macOS's ~10px window radius; at corner_radius they read as
# sharper than the window around them, so they round a little more.
island_radius = 8
rounded_call = re.compile(r"\.rounded(_[a-z]+)?\(([^()]*)\)")


def capped_corner(match):
    """One .rounded*() call with its radius capped at corner_radius."""
    side, value = match.group(1) or "", match.group(2).strip()
    if side == "_full":
        return f".rounded({corner_radius})"
    try:
        radius = min(float(value), corner_radius)
    except ValueError:
        radius = corner_radius
    return f".rounded{side}({radius:g})"
light_fallback = "paper"
# macOS always draws the window buttons, but Herdr doesn't clamp where; off
# the window's top-left corner they're out of sight. The tabs mod sizes its
# inset from this and falls to its minimum; the bar's fixed inset goes below.
hidden_traffic_lights = [-200, -200]
# The square tab bars drop the macOS inset for those buttons. The threads
# layout's also drops the space chip; the sidebar's spaces list already shows
# and switches the space.
bar_mod = "terminals-bar"
macos_inset = '.when(w.platform === "macos" && w.titlebar === "none" && !w.fullscreen, (el) => el.pl(72))'
bar_edits = [(macos_inset, "")]
# Its tabs fill the bar, Safari style: the tray runs up to the buttons and
# splits its width evenly between the tabs, which shrink as more open. A
# narrow tab drops its folder first, then truncates its name.
fill_tabs = [
    (".flex_shrink(1)\n        .w(260)\n        .min_w(0)", ".flex_1()\n        .min_w(0)"),
    ("h_flex()\n          .flex_shrink(1)\n          .min_w(0)\n          .h(36)", "h_flex()\n          .flex_1()\n          .min_w(0)\n          .h(36)"),
    ("      .child(div().flex_1())\n", ""),
    ('div().flex_none().text_color(c.active ? C.text : "#c4c6ca")', 'div().min_w(0).truncate().text_color(c.active ? C.text : "#c4c6ca")'),
    ("div().truncate().text_color(C.dim).child(where)", "div().min_w(0).flex_shrink(100).truncate().text_color(C.dim).child(where)"),
]
threads_bar = (
    "-threads",
    [('.id("tm-space")', '.id("tm-space")\n          .hidden()'), *bar_edits, *fill_tabs],
)
# The threads layout's spaces list tints each machine's group, header and
# spaces alike: the Mac gray, the NixOS thinkpad light blue, malinka red.
# "This computer" takes its own platform's tint. Only once a second machine is
# known; a lone computer's list has no groups.
spaces_mod = "spaces"
machine_tints = {"macos": "#a0a4ab1c", "thinkpad": "#6cb6ff1f", "malinka": "#ff5c5c1f"}
group_tint = (
    "const tints = " + json.dumps(machine_tints) + ";\n"
    "    const tinted = (m, items) => [v_flex().id(`machine-group-${m ?? \"local\"}`).flex_none().mb(6).pb(2)"
    ".bg(tints[m ?? (window().platform === \"macos\" ? \"macos\" : \"thinkpad\")] ?? \"#00000000\").children(items)];\n"
    "    const machineNames = [null, ...remote];"
)
# Each machine header also shows CPU, GPU (a Pi: SoC temperature), RAM and
# disk bars from herdr-app/machine-stats.js, copied in as stats.js.
# They poll only once a second machine is known, every 5s with the window in front.
machine_stats = repo / "herdr-app/machine-stats.js"
herdr_import = 'import { spaces, machines, panes, run, openOverlay, exec, hc, theme, shared, setShared, watchFolder, window, layout } from "herdr";'
machines_timer = "cx.timer.every(15000, cx => this.refreshMachines(cx));"
add_button = '.when(connected, el => el.child(div().id(`machine-add-${m ?? "local"}`)'
machine_stats_edits = [
    (herdr_import, herdr_import + '\nimport MachineStats from "./stats.js";'),
    (
        machines_timer,
        machines_timer + "\n    this.stats = new MachineStats();\n"
        "    cx.timer.every(1000, cx => this.machines.length && this.stats.poll([null, ...this.machines.filter(k => k.state === \"connected\").map(k => k.name)], cx));",
    ),
    (add_button, ".when(connected, el => el.child(this.stats.view(m, t)))\n          " + add_button),
]
# Each space's row also ends with an icon per coding agent running in it (a
# status dot, its thread on hover, click to go there), from
# herdr-app/space-agents.js, copied in as agents.js.
space_agents = repo / "herdr-app/space-agents.js"
agents_import = 'import { agentsBySpace, agentMarks } from "./agents.js";'
rows_read = "const rows = this.ordered();"
git_tail = "gitTail(g, tree, name, t) {"
tail_where = ".when(Boolean(where), (el) => el.child(div().min_w(0).truncate().child(where)))"
row_head = "row({ w, i, g, tree }, t) {"
row_tail = ".child(g ? this.gitTail(g, tree, w.name, t) : div().flex_1()),"
space_agents_edits = [
    (herdr_import, herdr_import + "\n" + agents_import),
    (rows_read, rows_read + "\n    this.agents = agentsBySpace(spaces());"),
    (git_tail, "gitTail(g, tree, name, t, marks) {"),
    (tail_where, tail_where + "\n      .when(Boolean(marks), (el) => el.child(marks))"),
    (row_head, row_head + "\n    const marks = agentMarks(this.agents?.[w.id], t, w.id);"),
    (
        row_tail,
        ".child(g ? this.gitTail(g, tree, w.name, t, marks) : h_flex().flex_1().justify_end().when(Boolean(marks), (el) => el.child(marks))),",
    ),
]
# Each space whose project has a favicon or app icon shows it in place of its
# letter square, from herdr-app/space-favicons.js, copied in as favicons.js.
space_favicons = repo / "herdr-app/space-favicons.js"
git_poll = "cx.timer.every(250, (cx) => this.checkNew(cx));"
letter_head = ".when(!tree, el => el.child(h_flex().size(18)"
letter_tail = '.child([...w.name][0]?.toUpperCase() ?? "?")))'
space_favicons_edits = [
    (herdr_import, herdr_import + '\nimport Favicons from "./favicons.js";'),
    (
        git_poll,
        git_poll + "\n    this.favicons = new Favicons();\n"
        "    cx.timer.every(2000, (cx) => this.favicons.poll(spaces(), panes(), cx));",
    ),
    (rows_read, rows_read + "\n    this.ps = panes();"),
    (letter_head, ".when(!tree, el => el.child(this.favicons.mark(w, this.ps ?? panes(), h_flex().size(18)"),
    (letter_tail, letter_tail + ")"),
]
threads_spaces = (
    "-threads",
    [
        ("const machineNames = [null, ...remote];", group_tint),
        ("if (!collapsed && rebuilt) return [head];", "if (!collapsed && rebuilt) return tinted(m, [head]);"),
        (
            "return [head, ...(folded ? [] : mine.length ? mine.map(draw) : [loading(m) ? loadingRow(m) : empty])];",
            "return tinted(m, [head, ...(folded ? [] : mine.length ? mine.map(draw) : [loading(m) ? loadingRow(m) : empty])]);",
        ),
        *machine_stats_edits,
        *space_agents_edits,
        *space_favicons_edits,
    ],
)


# The quest layout's HUD look (herdr-app/mods/hud/game.js has the same palette):
# warm stone chrome with bronze edges and a gold accent. The terminals keep
# the dotfiles theme and their own background.
quest_colors = {
    "background": "#0e0c0a",
    "surface": "#15110d",
    "raised": "#211a13",
    "hover": "#ffffff0a",
    "border": "#3a2d1c",
    "foreground": "#ece1c8",
    "muted": "#c3b498",
    "dim": "#9c8b6c",
    "selection": "#4a3720",
    "accent": "#d6a54a",
}
quest_pane = {"border": {"width": 1, "color": "#3a2d1c"}, "focus": {"width": 1, "color": "#d6a54a"}}


def quest_workspace(gap, children):
    """Hotbar, the panes, the run log (hidden until Play) and the XP strip."""
    panes = [child for child in children if "tab" in child.get("content", {})]
    if len(panes) != 1:
        sys.exit("herdr-app-setup: the terminals layout no longer has exactly one pane block; Herdr changed it")
    hud = lambda role: {"mod": "hud", "props": {"role": role}}
    return {
        "id": "workspace",
        "type": "column",
        "gap": gap,
        "children": [
            {"id": "hotbar", "type": "block", "size": {"px": 38}, "window_drag": True, "content": hud("bar")},
            panes[0],
            {"id": "run-log", "type": "block", "size": {"px": 220}, "min": 90, "max": 600, "hidden": True, "content": hud("log")},
            {"id": "xp", "type": "block", "size": {"px": 30}, "content": hud("xp")},
        ],
    }


def squared(node, mods):
    """Cap every radius in a layout tree and point shipped mods at square copies."""
    if isinstance(node, list):
        return [squared(child, mods) for child in node]
    if not isinstance(node, dict):
        return node
    result = {}
    for key, value in node.items():
        if key == "radius":
            result[key] = corner_radius
        elif key == "mod" and isinstance(value, str) and (app_home / "mods" / value).is_dir() and not (app_home / "mods" / value).is_symlink():
            mods.add(value)
            result[key] = value + square_suffix
        else:
            result[key] = squared(value, mods)
    return result


def pane_looks(node):
    """Every tab block's pane look ({"tab": ..., "pane": {...}}) in a layout tree."""
    if isinstance(node, list):
        for child in node:
            yield from pane_looks(child)
    elif isinstance(node, dict):
        if "tab" in node and isinstance(node.get("pane"), dict):
            yield node["pane"]
        for value in node.values():
            yield from pane_looks(value)


def write_square_mod(name, names, variant="", edits=(), extra=None):
    """Write mods/<name>-square<variant>; edits are (old, new) swaps in its main.js,
    extra maps more file names to sources copied in beside it."""
    source = app_home / "mods" / name
    target = app_home / "mods" / (name + square_suffix + variant)
    if target.is_symlink():
        sys.exit(f"herdr-app-setup: {target} is a symlink; refusing to overwrite it")
    target.mkdir(exist_ok=True)
    for path in source.iterdir():
        if path.suffix != ".js" and path.name != "mod.json":
            continue
        if path.suffix == ".js":
            text = rounded_call.sub(capped_corner, path.read_text())
            for other in names:
                text = re.sub(rf'(mod:\s*)"{re.escape(other)}"', rf'\1"{other}{square_suffix}"', text)
            for old, new in edits if path.name == "main.js" else ():
                if text.count(old) != 1:
                    sys.exit(f"herdr-app-setup: {old!r} is not in {path} exactly once; Herdr changed the mod")
                text = text.replace(old, new)
        else:
            text = path.read_text()
        out = target / path.name
        if not out.exists() or out.read_text() != text:
            out.write_text(text)
            print(f"updated {out}")
    for file_name, source_path in (extra or {}).items():
        out = target / file_name
        text = source_path.read_text()
        if not out.exists() or out.read_text() != text:
            out.write_text(text)
            print(f"updated {out}")
    # Icons stay in the shipped folder; the code addresses them as mods/<name>/.


def load(path):
    return json.loads(path.read_text())


def save(path, data):
    text = json.dumps(data, indent=2, ensure_ascii=True) + "\n"
    if path.exists() and path.read_text() == text:
        return False
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(text)
    temporary.replace(path)
    print(f"updated {path}")
    return True


required = [app_home / "keys.json", app_home / "settings.json"]
required += [app_home / "layouts" / f"{base}.json" for base in nav_layouts.values()]
missing = [str(path) for path in required if not path.exists()]
if missing:
    sys.exit("herdr-app-setup: start Herdr once first; missing " + ", ".join(missing))

# The layouts below show these mods; without one Herdr rejects them and lists none.
for mod in linked_mods:
    linked = app_home / "mods" / mod
    expected = repo / "herdr-app/mods" / mod
    if not linked.is_symlink() or linked.resolve() != expected.resolve():
        sys.exit(f"herdr-app-setup: {linked} is not linked to {expected}; apply the flake (nrs), then re-run")

theme_palette = state / "current/theme.json"
if theme_palette.exists():
    subprocess.run([str(repo / "scripts/herdr-theme"), "--app-only", str(theme_palette)], check=True)
else:
    print(f"herdr-app-setup: no {theme_palette}; run `theme <name>` to write themes/dotfiles.json")

spec = load(repo / "herdr-app/keys.json")
keys = load(app_home / "keys.json")
for section, chords in spec.get("unset", {}).items():
    for chord in chords:
        keys.get(section, {}).pop(chord, None)
for section, bindings in spec.get("set", {}).items():
    keys.setdefault(section, {}).update(bindings)
save(app_home / "keys.json", keys)

square_mods = set()
layouts = {}
for name, base in nav_layouts.items():
    layout = squared(load(app_home / "layouts" / f"{base}.json"), square_mods)
    floating = [block for block in layout.get("floating", []) if block.get("id") != "nav"]
    floating.append({"id": "nav", "content": {"mod": "nav"}, "edge": "bottom", "align": "end"})
    layout["floating"] = floating
    for pane in pane_looks(layout):
        pane["focus"] = dict(pane_focus)
    layout.get("colors", {}).pop("accent", None)
    if "traffic_lights" in layout:
        layout["traffic_lights"] = list(hidden_traffic_lights)
    if name == "quest":
        gap = layout.get("gap", 8)
        workspace = quest_workspace(gap, layout.get("children", []))
        for pane in pane_looks(workspace):
            pane.update(json.loads(json.dumps(quest_pane)))
        layout["children"] = [{"id": "body", "type": "row", "gap": gap, "children": [threads_sidebar(gap, square_mods, "hud"), workspace]}]
        layout["colors"] = {**layout.get("colors", {}), **quest_colors}
        layout["background"] = quest_colors["background"]
    if name == "threads":
        # The sidebar runs the window's full height and the tab bar sits in a
        # column over the panes only, so the tabs line up with the panes.
        gap = layout.get("gap", 8)
        workspace = {"id": "workspace", "type": "column", "gap": gap, "children": layout.get("children", [])}
        for child in workspace["children"]:
            if child.get("content", {}).get("mod") == bar_mod + square_suffix:
                child["content"]["mod"] = bar_mod + square_suffix + threads_bar[0]
        sidebar = threads_sidebar(gap, square_mods)
        for child in sidebar["children"]:
            if child["content"]["mod"] == spaces_mod + square_suffix:
                child["content"]["mod"] += threads_spaces[0]
        layout["children"] = [{"id": "body", "type": "row", "gap": gap, "children": [sidebar, workspace]}]
    shipped_theme = layout.get("theme")
    light = shipped_theme if isinstance(shipped_theme, str) else light_fallback
    layout["theme"] = {"light": light, "dark": "dotfiles"}
    layouts[name] = layout

# Copies first, so a layout never names a mod that doesn't exist yet.
for mod in sorted(square_mods):
    write_square_mod(mod, square_mods, "", bar_edits if mod == bar_mod else ())
if bar_mod in square_mods:
    write_square_mod(bar_mod, square_mods, *threads_bar)
if spaces_mod in square_mods:
    write_square_mod(spaces_mod, square_mods, *threads_spaces, {"stats.js": machine_stats, "agents.js": space_agents, "favicons.js": space_favicons})
for name, layout in layouts.items():
    save(app_home / "layouts" / f"{name}.json", layout)

settings = load(app_home / "settings.json")
settings["theme"] = {"light": light_fallback, "dark": "dotfiles"}
save(app_home / "settings.json", settings)

# Herdr keeps the last good file and explains a rejected one in <name>.error.
time.sleep(1.5)
for error in sorted((app_home / "layouts").glob("*.error")) + sorted(app_home.glob("*.error")):
    print(f"herdr-app-setup: Herdr rejected a file, see {error}:\n{error.read_text().strip()}", file=sys.stderr)

# Show a nav layout in a running window that is still on a shipped one.
status = subprocess.run(["herdr-app", "status"], capture_output=True, text=True)
if status.returncode == 0:
    shown = json.loads(status.stdout).get("layout")
    if shown not in nav_layouts:
        subprocess.run(["herdr-app", "do", "layout.switch", "--name", "main-nav"], check=False, stdout=subprocess.DEVNULL)
        print(f"switched the running window from {shown} to main-nav")
