#!/usr/bin/env python3
"""Apply the repository's Herdr app setup to ~/.config/herdr-app.

The app rewrites its home folder in place, so instead of symlinking its files
this merges the tracked pieces into them. Safe to re-run; it only writes files
whose content changes. Start Herdr once first so its defaults exist.

- keys.json: herdr-app/keys.json removes ("unset") and binds ("set") keys on
  top of the app's defaults.
- layouts/main-nav.json, layouts/terminals-nav.json: Herdr's shipped main and
  terminals layouts plus an empty floating block holding the nav mod, which
  owns Ctrl+h/j/k/l. Regenerated from the shipped files, so re-running picks
  up Herdr's layout updates.
- layouts/threads.json: terminals-nav with a full-height left sidebar:
  Herdr's spaces list, the threads mod (Claude Code, OpenCode and omp threads,
  scripts/agent-threads) and the usage mod (Claude Code and Codex plan usage,
  scripts/agent-usage), top to bottom. The tab bar sits over the panes only
  and drops its space chip and macOS window-button inset
  (mods/terminals-bar-square-threads). Its spaces list tints each machine's
  group (mods/spaces-square-threads): Mac gray, thinkpad light blue, malinka red.
- mods/<name>-square: square-cornered copies of the shipped mods the nav
  layouts show (every .rounded*() call set to 0), which those layouts use
  along with radius 0. Herdr's own popup and dialog frames stay rounded.
- settings.json and the nav layouts use themes/dotfiles.json in dark mode,
  which scripts/herdr-theme writes from the current dotfiles palette.
- mods/nav, mods/threads and mods/usage come from nix/symlinks.nix (herdr-app/mods/*);
  this only checks them.
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

repo = Path(__file__).resolve().parent.parent
app_home = Path(os.environ.get("HERDR_APP_HOME", Path.home() / ".config/herdr-app"))
state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "dotfiles-theme"
nav_layouts = {"main-nav": "main", "terminals-nav": "terminals", "threads": "terminals"}
linked_mods = ["nav", "threads", "usage"]


def threads_sidebar(gap):
    return {
        "id": "threads",
        "type": "column",
        "gap": gap,
        "size": {"px": 300},
        "min": 220,
        "max": 520,
        "children": [
            {"id": "spaces", "type": "block", "size": {"px": 200}, "min": 90, "border": {"width": 1, "color": "border"}, "content": {"mod": "spaces"}},
            {"id": "thread-list", "type": "block", "content": {"mod": "threads"}},
            {"id": "usage", "type": "block", "size": {"px": 232}, "min": 120, "content": {"mod": "usage"}},
        ],
    }


# The terminals look marks the focused pane with a border barely lighter than
# the rest; the theme accent stands out without shouting. The look's own accent
# (a bright blue) is dropped so the dotfiles theme's, from the current palette
# (scripts/herdr-theme), shows through.
pane_focus = {"width": 1, "color": "accent"}
square_suffix = "-square"
rounded_call = re.compile(r"\.rounded(?:_[a-z]+)?\([^()]*\)")
light_fallback = "paper"
# The threads layout's tab bar drops the space chip; the sidebar's spaces list
# already shows and switches the space. It also drops the macOS inset for the
# window buttons, which sit over the full-height sidebar there instead.
bar_mod = "terminals-bar"
macos_inset = '.when(w.platform === "macos" && w.titlebar === "none" && !w.fullscreen, (el) => el.pl(72))'
threads_bar = (
    "-threads",
    [
        ('.id("tm-space")', '.id("tm-space")\n          .hidden()'),
        (macos_inset, ""),
    ],
)
# The threads layout's spaces list tints each machine's group, header and
# spaces alike: the Mac gray, the NixOS thinkpad light blue, malinka red.
# "This computer" takes its own platform's tint. Only once a second machine is
# known; a lone computer's list has no groups.
spaces_mod = "spaces"
machine_tints = {"macos": "#a0a4ab1c", "thinkpad": "#6cb6ff1f", "malinka": "#ff5c5c1f"}
group_tint = (
    "const tints = " + json.dumps(machine_tints) + ";\n"
    "    const tinted = (m, items) => [v_flex().id(`machine-group-${m ?? \"local\"}`).flex_none().mb(6).pb(2)"
    ".bg(tints[m ?? (window().platform === \"macos\" ? \"macos\" : \"thinkpad\")] ?? \"#00000000\").children(items)];\n"
    "    const machineNames = [null, ...remote];"
)
threads_spaces = (
    "-threads",
    [
        ("const machineNames = [null, ...remote];", group_tint),
        ("if (!collapsed && rebuilt) return [head];", "if (!collapsed && rebuilt) return tinted(m, [head]);"),
        (
            "return [head, ...(folded ? [] : mine.length ? mine.map(draw) : [loading(m) ? loadingRow(m) : empty])];",
            "return tinted(m, [head, ...(folded ? [] : mine.length ? mine.map(draw) : [loading(m) ? loadingRow(m) : empty])]);",
        ),
    ],
)


def squared(node, mods):
    """Zero every radius in a layout tree and point shipped mods at square copies."""
    if isinstance(node, list):
        return [squared(child, mods) for child in node]
    if not isinstance(node, dict):
        return node
    result = {}
    for key, value in node.items():
        if key == "radius":
            result[key] = 0
        elif key == "mod" and isinstance(value, str) and (app_home / "mods" / value).is_dir() and not (app_home / "mods" / value).is_symlink():
            mods.add(value)
            result[key] = value + square_suffix
        else:
            result[key] = squared(value, mods)
    return result


def pane_looks(node):
    """Every tab block's pane look ({"tab": ..., "pane": {...}}) in a layout tree."""
    if isinstance(node, list):
        for child in node:
            yield from pane_looks(child)
    elif isinstance(node, dict):
        if "tab" in node and isinstance(node.get("pane"), dict):
            yield node["pane"]
        for value in node.values():
            yield from pane_looks(value)


def write_square_mod(name, names, variant="", edits=()):
    """Write mods/<name>-square<variant>; edits are (old, new) swaps in its main.js."""
    source = app_home / "mods" / name
    target = app_home / "mods" / (name + square_suffix + variant)
    if target.is_symlink():
        sys.exit(f"herdr-app-setup: {target} is a symlink; refusing to overwrite it")
    target.mkdir(exist_ok=True)
    for path in source.iterdir():
        if path.suffix != ".js" and path.name != "mod.json":
            continue
        if path.suffix == ".js":
            text = rounded_call.sub(".rounded(0)", path.read_text())
            for other in names:
                text = re.sub(rf'(mod:\s*)"{re.escape(other)}"', rf'\1"{other}{square_suffix}"', text)
            for old, new in edits if path.name == "main.js" else ():
                if text.count(old) != 1:
                    sys.exit(f"herdr-app-setup: {old!r} is not in {path} exactly once; Herdr changed the mod")
                text = text.replace(old, new)
        else:
            text = path.read_text()
        out = target / path.name
        if not out.exists() or out.read_text() != text:
            out.write_text(text)
            print(f"updated {out}")
    # Icons stay in the shipped folder; the code addresses them as mods/<name>/.


def load(path):
    return json.loads(path.read_text())


def save(path, data):
    text = json.dumps(data, indent=2, ensure_ascii=True) + "\n"
    if path.exists() and path.read_text() == text:
        return False
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(text)
    temporary.replace(path)
    print(f"updated {path}")
    return True


required = [app_home / "keys.json", app_home / "settings.json"]
required += [app_home / "layouts" / f"{base}.json" for base in nav_layouts.values()]
missing = [str(path) for path in required if not path.exists()]
if missing:
    sys.exit("herdr-app-setup: start Herdr once first; missing " + ", ".join(missing))

# The layouts below show these mods; without one Herdr rejects them and lists none.
for mod in linked_mods:
    linked = app_home / "mods" / mod
    expected = repo / "herdr-app/mods" / mod
    if not linked.is_symlink() or linked.resolve() != expected.resolve():
        sys.exit(f"herdr-app-setup: {linked} is not linked to {expected}; apply the flake (nrs), then re-run")

theme_palette = state / "current/theme.json"
if theme_palette.exists():
    subprocess.run([str(repo / "scripts/herdr-theme"), "--app-only", str(theme_palette)], check=True)
else:
    print(f"herdr-app-setup: no {theme_palette}; run `theme <name>` to write themes/dotfiles.json")

spec = load(repo / "herdr-app/keys.json")
keys = load(app_home / "keys.json")
for section, chords in spec.get("unset", {}).items():
    for chord in chords:
        keys.get(section, {}).pop(chord, None)
for section, bindings in spec.get("set", {}).items():
    keys.setdefault(section, {}).update(bindings)
save(app_home / "keys.json", keys)

square_mods = set()
layouts = {}
for name, base in nav_layouts.items():
    layout = squared(load(app_home / "layouts" / f"{base}.json"), square_mods)
    floating = [block for block in layout.get("floating", []) if block.get("id") != "nav"]
    floating.append({"id": "nav", "content": {"mod": "nav"}, "edge": "bottom", "align": "end"})
    layout["floating"] = floating
    for pane in pane_looks(layout):
        pane["focus"] = dict(pane_focus)
    layout.get("colors", {}).pop("accent", None)
    if name == "threads":
        # The sidebar runs the window's full height and the tab bar sits in a
        # column over the panes only, so the tabs line up with the panes.
        gap = layout.get("gap", 8)
        workspace = {"id": "workspace", "type": "column", "gap": gap, "children": layout.get("children", [])}
        for child in workspace["children"]:
            if child.get("content", {}).get("mod") == bar_mod + square_suffix:
                child["content"]["mod"] = bar_mod + square_suffix + threads_bar[0]
        sidebar = squared(threads_sidebar(gap), square_mods)
        for child in sidebar["children"]:
            if child["content"]["mod"] == spaces_mod + square_suffix:
                child["content"]["mod"] += threads_spaces[0]
        layout["children"] = [{"id": "body", "type": "row", "gap": gap, "children": [sidebar, workspace]}]
    shipped_theme = layout.get("theme")
    light = shipped_theme if isinstance(shipped_theme, str) else light_fallback
    layout["theme"] = {"light": light, "dark": "dotfiles"}
    layouts[name] = layout

# Copies first, so a layout never names a mod that doesn't exist yet.
for mod in sorted(square_mods):
    write_square_mod(mod, square_mods)
if bar_mod in square_mods:
    write_square_mod(bar_mod, square_mods, *threads_bar)
if spaces_mod in square_mods:
    write_square_mod(spaces_mod, square_mods, *threads_spaces)
for name, layout in layouts.items():
    save(app_home / "layouts" / f"{name}.json", layout)

settings = load(app_home / "settings.json")
settings["theme"] = {"light": light_fallback, "dark": "dotfiles"}
save(app_home / "settings.json", settings)

# Herdr keeps the last good file and explains a rejected one in <name>.error.
time.sleep(1.5)
for error in sorted((app_home / "layouts").glob("*.error")) + sorted(app_home.glob("*.error")):
    print(f"herdr-app-setup: Herdr rejected a file, see {error}:\n{error.read_text().strip()}", file=sys.stderr)

# Show a nav layout in a running window that is still on a shipped one.
status = subprocess.run(["herdr-app", "status"], capture_output=True, text=True)
if status.returncode == 0:
    shown = json.loads(status.stdout).get("layout")
    if shown not in nav_layouts:
        subprocess.run(["herdr-app", "do", "layout.switch", "--name", "main-nav"], check=False, stdout=subprocess.DEVNULL)
        print(f"switched the running window from {shown} to main-nav")
