#!/usr/bin/env python3
"""Generate local widget icon adapters (Herdr confines imports to each mod)."""
import hashlib
import json
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent


def render():
    root = REPO / "herdr-app/artwork"
    icons = {}
    for entry in json.loads((root / "catalog.json").read_text())["programs"]:
        data = (root / entry["icon"]).read_bytes()
        digest = hashlib.sha256(data).hexdigest()[:12]
        icons[entry["key"]] = {"icon": f"cards/illustrated/icon-{digest}.svg", "color": entry["color"]}
    header = "// Generated by scripts/herdr-program-icons-build; edit herdr-app/program-icons.js.\n"
    return header + "const PROGRAM_ICONS = " + json.dumps(icons, indent=2) + ";\n" + (REPO / "herdr-app/program-icons.js").read_text()


if __name__ == "__main__":
    text = render()
    for mod in ("threads", "usage"):
        target = REPO / f"herdr-app/mods/{mod}/program-icons.js"
        if not target.exists() or target.read_text() != text:
            target.write_text(text)
            print(f"updated {target}")
