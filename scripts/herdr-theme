#!/usr/bin/env python3
import json
import os
import re
import sys
from pathlib import Path

palette_path = Path(sys.argv[1])
config_path = Path(os.environ.get("HERDR_CONFIG_PATH", Path.home() / ".config/herdr/config.toml"))
palette = json.loads(palette_path.read_text())
theme = palette.get("herdr_theme", "terminal")
config = config_path.read_text()
updated, count = re.subn(
    r'(?m)^(\[theme\]\n)name = "[^"]*"',
    rf'\1name = "{theme}"',
    config,
    count=1,
)
if count != 1:
    raise SystemExit(f"Could not find [theme] name in {config_path}")
if updated != config:
    temporary = config_path.with_suffix(".toml.tmp")
    temporary.write_text(updated)
    temporary.replace(config_path)

# The Herdr app reads full terminal palettes from themes/<name>.json and
# reloads them live; settings.json selects "dotfiles".
app_home = Path(os.environ.get("HERDR_APP_HOME", Path.home() / ".config/herdr-app"))
if app_home.is_dir():
    ansi_names = ["black", "red", "green", "yellow", "blue", "purple", "aqua", "white"]
    app_theme = {
        "background": palette["background"],
        "foreground": palette["foreground"],
        "selection": palette["selection"],
        "cursor": palette["foreground"],
        "ansi": [palette[name] for name in ansi_names]
        + [palette[f"bright_{name}"] for name in ansi_names],
        "colors": {"accent": palette["accent"]},
    }
    theme_path = app_home / "themes/dotfiles.json"
    theme_path.parent.mkdir(exist_ok=True)
    temporary = theme_path.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(app_theme, indent=2) + "\n")
    temporary.replace(theme_path)
