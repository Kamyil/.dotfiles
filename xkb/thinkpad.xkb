xkb_keymap {
    xkb_keycodes { include "evdev+aliases(qwerty)" };
    xkb_types { include "complete" };
    xkb_compat { include "complete" };
    xkb_symbols {
        include "pc+pl(basic)+inet(evdev)+altwin(swap_lalt_lwin)+capslock(escape)"

        replace key <PRSC> { [ Control_R ] };
        replace key <RCTL> { [ Print ] };
        modifier_map None    { <RCTL> };
        modifier_map Control { <PRSC> };
    };
};
